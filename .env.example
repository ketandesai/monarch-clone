# Copy to .env and fill with real values. .env is git-ignored.

# Supabase Database & Auth Configuration
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Plaid API Configuration
# One client_id serves every environment — it does NOT change between sandbox and production.
PLAID_CLIENT_ID="your_plaid_client_id"
PLAID_SECRET="your_plaid_sandbox_secret"

# Exactly "sandbox" or "production" — any other value is rejected at startup rather than
# silently falling back to sandbox.
PLAID_ENV="sandbox"

PLAID_PRODUCTS="transactions"
PLAID_COUNTRY_CODES="US"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"